[sqlfluff]
# Migrations in this repo target SQL Server (NMCRISCTA, gisdata_108).
# Without this, sqlfluff defaults to the ansi dialect and reports T-SQL
# constructs (GO, USE, CREATE OR ALTER, [brackets]) as unparsable [PRS].
dialect = tsql
max_line_length = 120

# CP02 is disabled on purpose. The schema uses mixed-case Hungarian-ish names
# (iActivityNum, rSurveyAcres, sPerfOrgName) alongside UPPER_SNAKE object names
# (VW_ACTIVITIES_SURVEYS), so no single capitalisation policy fits. More
# importantly, a view's output column names take the case written in the query,
# and the published ArcGIS feature layers key off those exact field names --
# letting a linter lowercase them would silently break the GIS viewer.
#
# layout.indent (LT02) is off for the same kind of reason. Every nmcris migration wraps
# its body in SET XACT_ABORT ON / BEGIN TRANSACTION / COMMIT TRANSACTION and indents that
# body two spaces, which is the shape the repo's own migration skill documents. sqlfluff
# has no concept of a transaction block, so it calls every indented line wrong: 68 of the
# 90 warnings across that repo's migrations were this one rule. There is no setting for
# it either, since the [sqlfluff:indentation] keys only cover CTEs, joins, USING/ON, THEN
# and implicit indents.
exclude_rules = capitalisation.identifiers, layout.indent

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
